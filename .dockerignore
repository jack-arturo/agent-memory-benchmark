# Keep the build context small: exclude caches, the local venv, results, and the
# committed datasets (the repro compose bind-mounts ./data and ./outputs, and the
# download cache lives in a named volume — none of it belongs baked in the image).
.git
.venv
.datasets
data
outputs
.pytest_cache
.mypy_cache
.ruff_cache
**/__pycache__
*.pyc
*.pyo
*.log
.env
.env.*
.DS_Store
ui/node_modules
ui/dist
